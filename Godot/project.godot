; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ambrelune"
config/description="Ambrelune — prototype Godot (vertical slice des Plaines des Fougères)"
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.105882, 0.121569, 0.156863, 1)
config/icon="res://icon.svg"

[autoload]

Game="*res://core/game_state.gd"
Save="*res://core/save_system.gd"
Audio="*res://core/audio_director.gd"
Router="*res://core/scene_router.gd"
Dialogue="*res://ui/dialogue.gd"
Debug="*res://ui/debug_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[importer_defaults]

texture={
"mipmaps/generate": true
}

